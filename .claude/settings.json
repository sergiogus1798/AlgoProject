{
  "permissions": {
    "allow": [
      "Bash(python3:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(du:*)",
      "Bash(pgrep:*)",
      "Bash(ss:*)",
      "Bash(bin/sqx-worker.sh check)",
      "Bash(bin/sqx-log-prune.sh)",
      "Bash(bin/sqx-log-prune.sh --dry-run)",
      "Bash(bin/sqx-log-prune.sh --auto)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(awk:*)",
      "Bash(mkdir:*)",
      "Bash(unzip -l:*)",
      "Bash(curl -s http://127.0.0.1:*)",
      "Bash(curl -s http://localhost:*)",
      "mcp__sqx__list_databanks",
      "mcp__sqx__list_projects",
      "mcp__sqx__list_strategies",
      "mcp__sqx__get_strategy_stats",
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "mcp__sqx__*"
    ],
    "additionalDirectories": [
      "~/Desktop/AlgoData",
      "~/Desktop/SQX",
      "~/Desktop/SQX_w1",
      "~/Desktop/AlgoProject_Old"
    ],
    "ask": [
      "Bash(python3 -m sqx.curate.apply_verdict:*)",
      "Bash(bin/sqx-worker.sh start:*)",
      "Bash(bin/sqx-worker.sh stop:*)",
      "Bash(bin/sqx-worker.sh run:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)"
    ],
    "deny": [
      "Bash(pkill:*)",
      "Bash(killall:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/bin/sqx-log-prune.sh\" --auto 2>/dev/null || true",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/bin/sqx-log-prune.sh\" --auto 2>/dev/null || true",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ]
  }
}
