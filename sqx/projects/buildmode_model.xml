<!--
  Bloque de configuracion genetica del dueno, 2026-10-02: leido VERBATIM de la tarea Build del
  proyecto Test_Calib_USDJPY_H1_freeL_ver (custodio), que el configuro a mano en la interfaz, con
  PopulationSize a 250 por isla por orden suya del mismo dia ("pon 250 por isla, default ya para
  todo"). Es el default de TODO build del proyecto. Sustituye al bloque de XAUUSD_Breakout_H1
  (2026-09-23): poblacion 50 -> 250, generaciones 50 -> 25, cruce 80 -> 89, mutacion 30 -> 20,
  islas 24 -> 20, migracion 10 -> 3, sangre nueva cada 5 -> 10 generaciones, y SIN condiciones de
  poblacion inicial (antes NumberOfTrades > 150). Es su configuracion, no una decidida aqui.
-->
<BuildMode generationType="genetic-evolution">
  <PopulationSize>250</PopulationSize>
  <MaxGenerations>25</MaxGenerations>
  <CrossoverProbability>89</CrossoverProbability>
  <MutationProbability>20</MutationProbability>
  <ShowAdvancedGeneticSettings>false</ShowAdvancedGeneticSettings>
  <Islands>20</Islands>
  <MigrationModulo>10</MigrationModulo>
  <MigrationRate>3</MigrationRate>
  <ShowLastGenerationDatabank>true</ShowLastGenerationDatabank>
  <InitGenerationType>1</InitGenerationType>
  <DecimationCoef>1</DecimationCoef>
  <Conditions />
  <EvoRestartOnFinish status="true" />
  <EvoRestartOnStagnation status="true" fitnessType="11" generations="5" />
  <EvoInSamplePeriod ratio="50" />
  <FreshBloodReplaceSimilar>true</FreshBloodReplaceSimilar>
  <FreshBloodReplaceWeakest>true</FreshBloodReplaceWeakest>
  <FreshBloodWeakestPct>5</FreshBloodWeakestPct>
  <FreshBloodWeakestGenerations>10</FreshBloodWeakestGenerations>
  <FilterInitialPopulation>true</FilterInitialPopulation>
  <EvoFitnessRestartType>0</EvoFitnessRestartType>
  <EvoStagnationRestartGenerations>3</EvoStagnationRestartGenerations>
</BuildMode>
