# Machine-specific. The template is versioned; this file is not.
config/machine.yaml

# Data never lives in the repo.
*.csv
*.parquet
*.sqx
# The exceptions are code, not data: what a clean clone needs to run and to pass its tests.
# Until 2026-10-11 only the first was here, and gorilla — which only ever gets `git pull` — had
# no template skeletons (sqx/templates/build.py reads them), no fleet fixtures and no symbol
# table: 344 KB in all.
!tests/fixtures/*.sqx
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.parquet
!tools/sqx-lab/**/skeletons/*.sqx
!mt5/symbols.csv
*.cfx.bak

# Throwaway work.
scratch/
# The agents' reports moved to AlgoData/audit/ (2026-09-30); never back into the repo.
/audit/
__pycache__/
*.pyc
.venv/


# Editor noise.
.DS_Store

# Tool caches and per-machine Claude settings.
.ruff_cache/
.pytest_cache/
.claude/settings.local.json
# Graph output is a link into AlgoData (rule 7).
graphify-out
